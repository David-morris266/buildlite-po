# API base URL (Render production or staging)
VITE_API_URL=https://buildlite-po-api.onrender.com

# Commercial Event server authority (BL-028B.3 cutover)
# When true, runtime CE reads/writes use Postgres via /api/commercial-events.
# localStorage buildlite_commercial_events_v1 is backup/import only.
# VITE_CE_SERVER_AUTHORITY=true

# Order Matrix server authority (BL-029D cutover)
# When true, runtime matrix reads use the server cache and imports PUT to Postgres.
# localStorage buildlite_order_matrices_v1 is backup/rollback evidence only.
# Local UAT has passed; set this in .env.local on this machine. Do not commit .env.local.
# VITE_MATRIX_SERVER_AUTHORITY=true

# Payment Certificate server authority (BL-030C cutover)
# When true, V1 certificate create/edit/submit/reject/approve/delete and reads use Postgres.
# localStorage buildlite_subcontract_packages_v1 certificate arrays become backup/rollback evidence only.
# Local UAT has passed on Test Site 1 / Wipe It Cleaners. Set this in .env.local on this machine.
# Do not commit .env.local. Default remains OFF in this example.
# VITE_CERTIFICATE_SERVER_AUTHORITY=true

# CVR period server authority (BL-031D — local UAT passed)
# When true, CVR period/input reads and writes use Postgres. No localStorage fallback.
# Local UAT has passed on Test Site 1. Set this in .env.local on this machine.
# Do not commit .env.local. Default remains OFF in this example.
# VITE_CVR_SERVER_AUTHORITY=true

# Purchase ledger server authority (BL-031D — local UAT passed)
# When true, ledger import/reads/reverse use Postgres. No localStorage fallback.
# Local UAT has passed on Test Site 1. Set this in .env.local on this machine.
# Do not commit .env.local. Default remains OFF in this example.
# VITE_LEDGER_SERVER_AUTHORITY=true

# Local development override (copy to .env.local)
# VITE_API_URL=http://localhost:3001
# VITE_CE_SERVER_AUTHORITY=true
# VITE_MATRIX_SERVER_AUTHORITY=true
# VITE_CERTIFICATE_SERVER_AUTHORITY=true
# VITE_CVR_SERVER_AUTHORITY=true
# VITE_LEDGER_SERVER_AUTHORITY=true
