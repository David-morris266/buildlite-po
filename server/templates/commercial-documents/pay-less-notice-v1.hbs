<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4;margin:14mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#172033;font-size:10px;margin:0}header{display:flex;justify-content:space-between;border-bottom:3px solid {{presentation.payer.accentColor}};padding-bottom:10px}.logo{max-width:150px;max-height:50px}h1{font-size:23px;margin:0}.ref{font-size:16px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 22px;margin-top:14px}.label{color:#566274;text-transform:uppercase;font-size:8px}.value{font-weight:600;margin-top:2px}.position{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.position>div{padding:13px;border:2px solid #172033;background:#f2f5f8}.position .value{font-size:22px}.reduction{background:#fff4e5!important}.basis{padding:13px;border-left:4px solid #172033;background:#f2f5f8;font-size:13px;white-space:pre-wrap}.authority{margin-top:20px;border-top:1px solid #9ca6b2;padding-top:8px}h2{font-size:13px;margin:19px 0 7px;border-bottom:1px solid #bac3ce;padding-bottom:4px}footer{margin-top:24px;color:#667085;font-size:8px}</style></head><body>
<header><div>{{#if presentation.payer.logo}}<img class="logo" src="{{presentation.payer.logo}}">{{else}}<strong>{{presentation.payer.name}}</strong>{{/if}}<h1>PAY LESS NOTICE</h1></div><div><div class="label">Pay Less reference</div><div class="ref">{{payLess.reference}}</div><div>Reduces {{payLess.sourcePaymentNotice.reference}}</div><div>Source {{sourceCertificate.reference}}</div></div></header>
<section class="grid"><div><div class="label">Payer</div><div class="value">{{presentation.payer.name}}</div><div>{{presentation.payer.address}}</div></div><div><div class="label">Subcontractor</div><div class="value">{{presentation.payee.name}}</div><div>{{presentation.payee.address}}</div></div><div><div class="label">Development</div><div class="value">{{presentation.development.name}}</div></div><div><div class="label">Package / Cost code</div><div class="value">{{presentation.package.description}} / {{presentation.package.costCode}}</div><div>Purchase Order {{presentation.package.poReference}}</div></div></section>
<section class="position"><div><div class="label">NOTIFIED SUM</div><div class="value">{{formatMoney payLess.notifiedSum "GBP"}}</div></div><div><div class="label">INTENDED PAYMENT</div><div class="value">{{formatMoney payLess.intendedPayment "GBP"}}</div></div><div class="reduction"><div class="label">REDUCTION</div><div class="value">{{formatMoney payLess.reduction "GBP"}}</div></div></section>
<h2>Basis of calculation</h2><div class="basis">{{payLess.basisOfCalculation}}</div>
<section class="authority"><h2>Payment cycle and issue authority</h2><div class="grid"><div><div class="label">Due date</div><div class="value">{{formatDate payLess.timetable.dueDate}}</div></div><div><div class="label">Pay Less deadline</div><div class="value">{{formatDate payLess.timetable.payLessDeadline}}</div></div><div><div class="label">Final date for payment</div><div class="value">{{formatDate payLess.timetable.finalDateForPayment}}</div></div><div><div class="label">Issued by</div><div class="value">{{payLess.issuedBy}} · {{formatDate payLess.issuedAt}}</div></div><div><div class="label">Contract terms</div><div class="value">{{payLess.terms.familyName}}</div><div>{{payLess.terms.versionLabel}}{{#if payLess.terms.revisionNumber}} · Revision {{payLess.terms.revisionNumber}}{{/if}}</div></div></div></section>
<footer>{{presentation.payer.name}} · {{presentation.payer.address}}<br>{{presentation.payer.footer}}</footer></body></html>
