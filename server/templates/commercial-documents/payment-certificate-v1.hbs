<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4;margin:12mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#172033;font-size:10px;margin:0}header{display:flex;justify-content:space-between;border-bottom:3px solid {{presentation.payer.accentColor}};padding-bottom:10px}.logo{max-width:150px;max-height:50px}h1{font-size:22px;margin:0}h2{font-size:13px;margin:18px 0 7px;border-bottom:1px solid #bac3ce;padding-bottom:4px}.ref{font-size:16px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 22px;margin-top:12px}.grid div,.summary div{break-inside:avoid}.label{color:#566274;text-transform:uppercase;font-size:8px}.value{font-weight:600;margin-top:2px}.summary{display:grid;grid-template-columns:1fr 1fr;gap:7px 20px;background:#f2f5f8;padding:10px}.net{font-size:15px;border:2px solid #172033;padding:8px}table{width:100%;border-collapse:collapse;margin-top:6px}th,td{border:1px solid #c8ced6;padding:5px;text-align:left}th{background:#eef1f5}th.money,td.money{text-align:right}.muted{color:#667085}.authority{margin-top:18px;padding-top:8px;border-top:1px solid #9ca6b2}footer{margin-top:18px;color:#667085;font-size:8px}</style></head><body>
<header><div>{{#if presentation.payer.logo}}<img class="logo" src="{{presentation.payer.logo}}">{{else}}<strong>{{presentation.payer.name}}</strong>{{/if}}<h1>PAYMENT CERTIFICATE</h1></div><div><div class="label">Document reference</div><div class="ref">{{document.reference}}</div><div>Certificate No. {{document.certificateNumber}}</div></div></header>
<section class="grid"><div><div class="label">Development</div><div class="value">{{presentation.development.name}}</div><div>{{presentation.development.address}}</div></div><div><div class="label">Subcontractor</div><div class="value">{{presentation.payee.name}}</div><div>{{presentation.payee.address}}</div></div><div><div class="label">Package / Cost code</div><div class="value">{{presentation.package.description}} / {{presentation.package.costCode}}</div></div><div><div class="label">Purchase Order</div><div class="value">{{presentation.package.poReference}}</div></div></section>
<h2>Application and assessment</h2><section class="grid"><div><div class="label">Application reference</div><div class="value">{{application.reference}}</div></div><div><div class="label">Amount applied</div><div class="value">{{formatMoney application.amountApplied "GBP"}}</div></div><div><div class="label">Valuation date</div><div class="value">{{formatDate timetable.valuationDate}}</div></div><div><div class="label">Previous certified</div><div class="value">{{formatMoney financials.previousCertified "GBP"}}</div></div><div><div class="label">This certificate</div><div class="value">{{formatMoney financials.grossThisCertificate "GBP"}}</div></div><div><div class="label">Certified to date</div><div class="value">{{formatMoney financials.certifiedToDate "GBP"}}</div></div>{{#if application.comparable}}<div><div class="label">Difference to application</div><div class="value">{{#if application.difference}}{{formatMoney application.differenceAmount "GBP"}} {{application.differenceDirection}} than application{{else}}No difference{{/if}}</div></div>{{/if}}</section>
<h2>Certificate financial summary</h2><section class="summary"><div><span class="label">Gross certified</span><div class="value">{{formatMoney financials.grossThisCertificate "GBP"}}</div></div><div><span class="label">Retention</span><div class="value">{{formatMoney financials.retention "GBP"}}</div></div><div><span class="label">Recovery / contra deductions</span><div class="value">{{formatMoney financials.recoveries "GBP"}}</div></div><div><span class="label">VAT</span><div class="value">{{formatMoney financials.vat "GBP"}}</div></div><div class="net"><span class="label">NET PAYMENT DUE</span><div class="value">{{formatMoney financials.netPayment "GBP"}}</div></div></section>
{{#if valuation.cells.length}}<h2>Valuation detail</h2><table><thead><tr><th>Plot</th><th>Stage</th><th class="money">Contract value</th><th class="money">Previous</th><th class="money">This certificate</th><th class="money">To date</th></tr></thead><tbody>{{#each valuation.cells}}<tr><td>{{plot}}</td><td>{{stage}}</td><td class="money">{{formatMoney contractValue "GBP"}}</td><td class="money">{{formatMoney previousCertified "GBP"}}</td><td class="money">{{formatMoney thisCertificate "GBP"}}</td><td class="money">{{formatMoney certifiedToDate "GBP"}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if commercialLines.length}}<h2>Commercial adjustments</h2><table><thead><tr><th>Type</th><th>Reference</th><th>Description</th><th class="money">This certificate</th></tr></thead><tbody>{{#each commercialLines}}<tr><td>{{type}}</td><td>{{reference}}</td><td>{{description}}</td><td class="money">{{formatMoney amount "GBP"}}</td></tr>{{/each}}</tbody></table>{{/if}}
<section class="authority"><h2>Authority and timetable</h2><div class="grid"><div><span class="label">Due date</span><div class="value">{{formatDate timetable.dueDate}}</div></div><div><span class="label">Final date for payment</span><div class="value">{{formatDate timetable.finalDateForPayment}}</div></div><div><span class="label">Submitted by</span><div class="value">{{authority.submittedBy}}</div></div><div><span class="label">Approved</span><div class="value">{{authority.approvedBy}} · {{formatDate authority.approvedAt}}</div></div><div><span class="label">Contract terms</span><div class="value">{{terms.familyName}}</div><div>{{terms.versionLabel}}{{#if terms.revisionNumber}} · Revision {{terms.revisionNumber}}{{/if}}</div></div></div></section>
<footer>{{presentation.payer.name}} · {{presentation.payer.address}} {{#if presentation.payer.companyNumber}}· Company No. {{presentation.payer.companyNumber}}{{/if}} {{#if presentation.payer.vatNumber}}· VAT No. {{presentation.payer.vatNumber}}{{/if}}<br>{{presentation.payer.footer}}</footer>
</body></html>
