<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4;margin:11mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#172033;font-size:9px;margin:0}header{display:flex;justify-content:space-between;border-bottom:3px solid {{presentation.payer.accentColor}};padding-bottom:8px}.logo{max-width:145px;max-height:46px}h1{font-size:20px;margin:0}h2{font-size:12px;margin:14px 0 5px;border-bottom:1px solid #bac3ce;padding-bottom:3px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:5px 18px;margin-top:9px}.label{color:#566274;text-transform:uppercase;font-size:7px}.value{font-weight:600;margin-top:1px}.summary{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;background:#f2f5f8;padding:7px}.net,.notified{border:2px solid #172033;padding:7px}.notice{margin-top:15px;border:3px solid #172033;padding:10px}.notice h2{font-size:17px;border:0;margin:0 0 8px}.notified .value{font-size:20px}.basis{background:#f2f5f8;padding:7px;margin-top:7px}table{width:100%;border-collapse:collapse;margin-top:4px}th,td{border:1px solid #c8ced6;padding:4px}th{background:#eef1f5}th.money,td.money{text-align:right}footer{margin-top:14px;padding-top:7px;border-top:1px solid #bac3ce;color:#4b5565;font-size:9px;line-height:1.45}</style></head><body>
<header><div>{{#if presentation.payer.logo}}<img class="logo" src="{{presentation.payer.logo}}">{{else}}<strong>{{presentation.payer.name}}</strong>{{/if}}<h1>PAYMENT CERTIFICATE &amp; PAYMENT NOTICE</h1></div><div><strong>{{certificate.document.reference}}</strong><br>{{notice.reference}}<br>Certificate No. {{certificate.document.certificateNumber}}</div></header>
<section class="grid"><div><div class="label">Development</div><div class="value">{{presentation.development.name}}</div></div><div><div class="label">Subcontractor</div><div class="value">{{presentation.payee.name}}</div></div><div><div class="label">Package / Cost code</div><div class="value">{{presentation.package.description}} / {{presentation.package.costCode}}</div></div><div><div class="label">Purchase Order</div><div class="value">{{presentation.package.poReference}}</div></div></section>
<h2>Application and certificate assessment</h2><section class="grid"><div><div class="label">Application</div><div class="value">{{certificate.application.reference}} · {{formatMoney certificate.application.amountApplied "GBP"}}</div></div><div><div class="label">Assessment</div><div class="value">{{formatMoney certificate.financials.grossThisCertificate "GBP"}}</div></div>{{#if certificate.application.comparable}}<div><div class="label">Difference to application</div><div class="value">{{#if certificate.application.difference}}{{formatMoney certificate.application.differenceAmount "GBP"}} {{certificate.application.differenceDirection}} than application{{else}}No difference{{/if}}</div></div>{{/if}}</section>
<h2>Certificate financial summary</h2><section class="summary"><div><div class="label">Gross</div><div class="value">{{formatMoney certificate.financials.grossThisCertificate "GBP"}}</div></div><div><div class="label">Retention</div><div class="value">{{formatMoney certificate.financials.retention "GBP"}}</div></div><div><div class="label">Recovery / contra</div><div class="value">{{formatMoney certificate.financials.recoveries "GBP"}}</div></div><div><div class="label">VAT</div><div class="value">{{formatMoney certificate.financials.vat "GBP"}}</div></div><div class="net"><div class="label">NET CERTIFICATE</div><div class="value">{{formatMoney certificate.financials.netPayment "GBP"}}</div></div></section>
{{#if certificate.valuation.cells.length}}<h2>Valuation detail</h2><table><thead><tr><th>Plot</th><th>Stage</th><th class="money">Contract value</th><th class="money">Previous</th><th class="money">This certificate</th><th class="money">To date</th></tr></thead><tbody>{{#each certificate.valuation.cells}}<tr><td>{{plot}}</td><td>{{stage}}</td><td class="money">{{formatMoney contractValue "GBP"}}</td><td class="money">{{formatMoney previousCertified "GBP"}}</td><td class="money">{{formatMoney thisCertificate "GBP"}}</td><td class="money">{{formatMoney certifiedToDate "GBP"}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if certificate.commercialLines.length}}<h2>Commercial adjustments</h2><table><thead><tr><th>Type</th><th>Reference</th><th>Description</th><th class="money">This certificate</th></tr></thead><tbody>{{#each certificate.commercialLines}}<tr><td>{{type}}</td><td>{{reference}}</td><td>{{description}}</td><td class="money">{{formatMoney amount "GBP"}}</td></tr>{{/each}}</tbody></table>{{/if}}
<section class="notice"><h2>PAYMENT NOTICE</h2><div class="grid"><div class="notified"><div class="label">NOTIFIED SUM</div><div class="value">{{formatMoney notice.notifiedSum "GBP"}}</div></div><div><div class="label">Notice reference</div><div class="value">{{notice.reference}}</div><div class="label">Issued</div><div class="value">{{notice.issuedBy}} · {{formatDate notice.issuedAt}}</div></div></div><div class="basis"><div class="label">Basis of calculation</div><div class="value">{{notice.basisOfCalculation}}</div></div><div><div class="label">Due date</div><div class="value">{{formatDate notice.timetable.dueDate}}</div><div class="label">Payment Notice deadline</div><div class="value">{{formatDate notice.timetable.paymentNoticeDeadline}}</div><div class="label">Final date for payment</div><div class="value">{{formatDate notice.timetable.finalDateForPayment}}</div></div></div></section>
<footer>Certificate approved by {{certificate.authority.approvedBy}} · Contract terms {{notice.terms.familyName}} {{notice.terms.versionLabel}}<br>{{presentation.payer.name}} · {{presentation.payer.footer}}</footer></body></html>
