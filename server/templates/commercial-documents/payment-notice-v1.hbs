<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4;margin:14mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#172033;font-size:10px;margin:0}header{display:flex;justify-content:space-between;border-bottom:3px solid {{presentation.payer.accentColor}};padding-bottom:10px}.logo{max-width:150px;max-height:50px}h1{font-size:23px;margin:0}h2{font-size:13px;margin:20px 0 7px;border-bottom:1px solid #bac3ce;padding-bottom:4px}.ref{font-size:16px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 22px;margin-top:14px}.label{color:#566274;text-transform:uppercase;font-size:8px}.value{font-weight:600;margin-top:2px}.notified{margin:18px 0;padding:14px;border:3px solid #172033;background:#f2f5f8}.notified .value{font-size:25px}.basis{padding:12px;background:#f2f5f8;font-size:12px}.summary{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.summary>div{padding:7px;border:1px solid #c8ced6}.authority{margin-top:20px;border-top:1px solid #9ca6b2;padding-top:8px}footer{margin-top:24px;color:#667085;font-size:8px}</style></head><body>
<header><div>{{#if presentation.payer.logo}}<img class="logo" src="{{presentation.payer.logo}}">{{else}}<strong>{{presentation.payer.name}}</strong>{{/if}}<h1>PAYMENT NOTICE</h1></div><div><div class="label">Notice reference</div><div class="ref">{{notice.reference}}</div><div>Source {{sourceCertificate.reference}}</div></div></header>
<section class="grid"><div><div class="label">Payer</div><div class="value">{{presentation.payer.name}}</div><div>{{presentation.payer.address}}</div></div><div><div class="label">Subcontractor</div><div class="value">{{presentation.payee.name}}</div><div>{{presentation.payee.address}}</div></div><div><div class="label">Development</div><div class="value">{{presentation.development.name}}</div></div><div><div class="label">Package / Cost code</div><div class="value">{{presentation.package.description}} / {{presentation.package.costCode}}</div><div>Purchase Order {{presentation.package.poReference}}</div></div></section>
<section class="notified"><div class="label">NOTIFIED SUM</div><div class="value">{{formatMoney notice.notifiedSum "GBP"}}</div></section>
<h2>Basis of calculation</h2><div class="basis">{{notice.basisOfCalculation}}</div>
<h2>Frozen assessment supporting this notice</h2><section class="summary"><div><div class="label">Gross</div><div class="value">{{formatMoney notice.assessed.gross "GBP"}}</div></div><div><div class="label">Retention</div><div class="value">{{formatMoney notice.assessed.retention "GBP"}}</div></div><div><div class="label">Recovery / contra</div><div class="value">{{formatMoney notice.assessed.recoveries "GBP"}}</div></div><div><div class="label">VAT</div><div class="value">{{formatMoney notice.assessed.vat "GBP"}}</div></div><div><div class="label">Assessed net</div><div class="value">{{formatMoney notice.assessed.net "GBP"}}</div></div></section>
<section class="authority"><h2>Payment cycle and issue authority</h2><div class="grid"><div><div class="label">Contractual valuation date</div><div class="value">{{formatDate notice.timetable.contractualValuationDate}}</div></div><div><div class="label">Due date</div><div class="value">{{formatDate notice.timetable.dueDate}}</div></div><div><div class="label">Payment Notice deadline</div><div class="value">{{formatDate notice.timetable.paymentNoticeDeadline}}</div></div><div><div class="label">Final date for payment</div><div class="value">{{formatDate notice.timetable.finalDateForPayment}}</div></div><div><div class="label">Issued by</div><div class="value">{{notice.issuedBy}} · {{formatDate notice.issuedAt}}</div></div><div><div class="label">Contract terms</div><div class="value">{{notice.terms.familyName}}</div><div>{{notice.terms.versionLabel}}{{#if notice.terms.revisionNumber}} · Revision {{notice.terms.revisionNumber}}{{/if}}</div></div></div></section>
<footer>{{presentation.payer.name}} · {{presentation.payer.address}}<br>{{presentation.payer.footer}}</footer></body></html>
