<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4 landscape;margin:0}*{box-sizing:border-box}html,body{width:297mm;height:210mm;margin:0}body{font-family:Arial,sans-serif;color:#17211f;background:#f5f7f5;-webkit-print-color-adjust:exact}.page{width:297mm;height:210mm;padding:6mm 7mm 5mm;overflow:hidden;display:grid;grid-template-rows:auto auto auto 1fr auto;gap:2mm}header{display:grid;grid-template-columns:43mm 1fr 62mm;align-items:center;border-bottom:1.2px solid #0d7452;padding-bottom:1.5mm}.brand{display:flex;align-items:center;gap:2mm}.brand img{max-width:11mm;max-height:11mm}.brand b{font-size:12pt}.brand b span{color:#008d61}.brand small{display:block;font-size:4.2pt;text-transform:uppercase}.identity h1{margin:0;font-size:14pt}.identity p,.status span{font-size:7.4pt;color:#596762}.status{text-align:right}.status strong{padding:1mm 2mm;border:1px solid #d9a632;background:#fff2d4;border-radius:9mm;font-size:6pt}.kpis{display:grid;grid-template-columns:repeat(7,1fr);gap:1.4mm}.kpi{background:#fff;border:1px solid #d7e0dc;border-top:2px solid #0b8b61;padding:1.1mm 1.5mm}.kpi label,.metric label{display:block;font-size:5pt;color:#5d6966;text-transform:uppercase}.kpi b{display:block;font-size:9.4pt;margin-top:.45mm;white-space:nowrap}.kpi small,.metric small{display:block;color:#68746f;font-size:4.2pt;margin-top:.2mm}.performance{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4mm}.metric{background:#eaf2ee;border-left:2px solid #0b8b61;padding:.9mm 1.5mm}.metric b{display:block;font-size:8.3pt;margin-top:.2mm}.body{min-height:0;display:grid;grid-template-rows:auto auto;gap:2mm;align-content:start}.title{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.75mm}.title h2{margin:0;color:#17483a;font-size:7.3pt;text-transform:uppercase}.title span{font-size:5.2pt;color:#68746f}table{width:100%;border-collapse:collapse;table-layout:fixed;font-variant-numeric:tabular-nums}th{background:#17483a;color:#fff;padding:1.15mm .75mm;font-size:5.5pt;text-align:right}td{padding:1.5mm .75mm;border-bottom:1px solid #dce4e1;text-align:right;font-size:7.6pt;white-space:nowrap}th:first-child,td:first-child{text-align:left}tbody tr:nth-child(even){background:#f1f5f3}tfoot td{background:#e3eee9;font-weight:700;border-top:1.4px solid #0d7452}.bottom{display:grid;grid-template-columns:1fr .75fr 1fr;gap:1.7mm;min-height:32mm}.panel{background:#fff;border:1px solid #d7e0dc;padding:1.7mm 1.8mm;min-height:32mm;font-size:7.2pt}.panel p{margin:.75mm 0;line-height:1.22}.exception{display:grid;grid-template-columns:auto 1fr auto;gap:1mm;align-items:baseline}.exception .amount{text-align:right;font-variant-numeric:tabular-nums}.flag{font-size:5pt;font-weight:700;letter-spacing:.03em}.adverse{color:#a3372d}.favourable{color:#087451}.neutral{color:#17211f}.trend svg{width:100%;height:14mm}.empty{color:#68746f}footer{display:grid;grid-template-columns:1fr auto 1fr;border-top:1px solid #bdcac5;padding-top:.9mm;font-size:4.6pt;color:#66736f}footer span:last-child{text-align:right}
</style></head><body><main class="page" data-head-count="{{heads.length}}"><header><div class="brand"><svg viewBox="0 0 48 48" width="34" height="34" aria-label="BuildLite Skyline"><path d="M5 42V23l9-6v25M15 42V12l10-7v37M26 42V16l9 6v20M36 42V27l7 4v11" fill="none" stroke="#087451" stroke-width="3"/></svg><div><b>Build<span>Lite</span></b><small>Lean Commercial Control</small></div></div><div class="identity"><h1>{{development.name}} — Monthly CVR Summary</h1><p>{{brand.company}} · {{development.number}} · {{integer development.plotCount}} plots</p></div><div class="status"><strong>{{statusLabel}}</strong><br><span>{{period.key}} · {{month period.reportingMonth}}</span></div></header>
<section class="kpis"><div class="kpi"><label>Forecast Revenue</label><b>{{money kpis.forecastRevenue}}</b><small>{{evidenceCaptions.revenue}}</small></div><div class="kpi"><label>Current EFC</label><b>{{money kpis.efc}}</b><small>{{evidenceCaptions.efc}}</small></div><div class="kpi"><label>Forecast GP</label><b>{{money kpis.grossProfit}}</b><small>Revenue less EFC</small></div><div class="kpi"><label>GP Margin</label><b>{{percent kpis.grossMarginPercent}}</b><small>Forecast profitability</small></div><div class="kpi"><label>Cost to Complete</label><b>{{money kpis.costToComplete}}</b><small>At reporting date</small></div><div class="kpi"><label>Variance from Site Start</label><b class="{{totals.varianceTone}}">{{signedMoney kpis.budgetVariance}}</b><small>{{evidenceCaptions.siteStart}}</small></div><div class="kpi"><label>{{kpis.movementLabel}}</label><b class="{{totals.periodTone}}">{{signedMoney kpis.periodMovement}}</b><small>{{movementEvidenceLabel}}</small></div></section>
<section class="performance"><div class="metric"><label>Total development cost</label><b>{{perFt2 performance.totalDevelopmentCostPerFt2}}</b><small>{{integer performance.gia}} ft² governed GIA</small></div><div class="metric"><label>Actual cost to date</label><b>{{money performance.actualCost}}</b><small>Governed ledger evidence</small></div><div class="metric"><label>EFC incurred</label><b>{{percent performance.efcIncurredPercent}}</b><small>Actual Cost ÷ Current EFC</small></div><div class="metric"><label>Current programme · live support</label><b>{{date programmeStart}} → {{date programmeFinish}}</b><small>Not frozen CVR evidence</small></div></section>
<div class="body"><section><div class="title"><h2>Commercial Head Summary</h2><span>All authoritative Heads · GIA {{integer performance.gia}} ft²</span></div><table><colgroup><col style="width:20%"><col span="8" style="width:10%"></colgroup><thead><tr><th>Commercial Head</th><th>Site Start Budget</th><th>Previous EFC</th><th>Current EFC</th><th>EFC £/ft²</th><th>{{kpis.movementLabel}}</th><th>Variance from Site Start</th><th>Cost to Complete</th><th>Change Exposure</th></tr></thead><tbody>{{#each heads}}<tr data-head-row><td>{{name}}</td><td>{{money siteStartBudget}}</td><td>{{money previousEfc}}</td><td><b>{{money currentEfc}}</b></td><td>{{perFt2 efcPerFt2}}</td><td class="{{periodTone}}">{{signedMoney displayMovement}}</td><td class="{{varianceTone}}">{{signedMoney budgetVariance}}</td><td>{{money costToComplete}}</td><td>{{signedMoney changeExposure}}</td></tr>{{/each}}</tbody><tfoot><tr><td>Development total</td><td>{{money totals.siteStartBudget}}</td><td>{{money totals.previousEfc}}</td><td>{{money totals.currentEfc}}</td><td>{{perFt2 totals.efcPerFt2}}</td><td class="{{totals.periodTone}}">{{signedMoney totals.displayMovement}}</td><td class="{{totals.varianceTone}}">{{signedMoney totals.budgetVariance}}</td><td>{{money totals.costToComplete}}</td><td>{{signedMoney totals.changeExposure}}</td></tr></tfoot></table></section>
<section class="bottom"><div class="panel"><div class="title"><h2>Exceptions & significant movements</h2><span>Authoritative evidence</span></div>{{#each exceptions}}<p class="exception"><span class="flag {{tone}}">{{label}}</span><b>{{name}}</b><span class="amount {{tone}}">{{signedMoney movement}} · Exposure {{signedMoney exposure}}</span></p>{{else}}<p class="empty">No authoritative commercial exceptions or movements.</p>{{/each}}</div><div class="panel trend"><div class="title"><h2>Locked GP margin</h2><span>{{trendRange}}</span></div><svg viewBox="0 0 310 66">{{#each trendPaths}}<path d="{{this}}" fill="none" stroke="#087451" stroke-width="2.4"/>{{/each}}{{#each trendPoints}}{{#if available}}<circle cx="{{x}}" cy="{{y}}" r="3" fill="#087451"/>{{else}}<circle cx="{{x}}" cy="{{y}}" r="3" fill="#fff" stroke="#8b9692"/>{{/if}}<text x="{{x}}" y="{{y}}" dy="-6" text-anchor="middle" font-size="7">{{label}}</text><text x="{{x}}" y="62" text-anchor="middle" font-size="7">{{periodKey}}</text>{{/each}}{{#if provisionalPoint}}<circle cx="{{provisionalPoint.x}}" cy="{{provisionalPoint.y}}" r="4" fill="#fff" stroke="#d39b20" stroke-width="2"/><text x="{{provisionalPoint.x}}" y="{{provisionalPoint.y}}" dy="-7" text-anchor="middle" font-size="7">{{provisionalPoint.label}}</text><text x="{{provisionalPoint.x}}" y="62" text-anchor="middle" font-size="7">{{provisionalPoint.periodKey}}*</text>{{/if}}</svg>{{#if trend.provisional}}<p>Current {{trend.provisional.periodKey}}: {{percent trend.provisional.margin}} (provisional marker; not connected).</p>{{/if}}</div><div class="panel"><div class="title"><h2>Management commentary</h2><span>Persisted CVR commentary</span></div>{{#each commentaryItems}}<p><b>{{this.[0]}}.</b> {{this.[1]}}</p>{{else}}<p class="empty">No persisted management commentary.</p>{{/each}}</div></section></div>
<footer><span>Generated {{dateTime generatedAt}}</span><span>CVR Summary · Page 1 of 1</span><span>Created: {{actor attribution.created}} · Submitted: {{actor attribution.submitted}} · Approved: {{actor attribution.approved}}</span></footer></main></body></html>
