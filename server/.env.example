# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Runtime/dev/UAT server connection (for example buildlite_clone).
# Local PostgreSQL: false. Render Postgres: true.
DATABASE_SSL=false

# Automated server integration tests use TEST_DATABASE_URL from server/.env.test.local
# (gitignored). Copy server/.env.test.local.example and point at a separate database
# such as buildlite_test. Tests fail closed if TEST_DATABASE_URL is missing or matches
# DATABASE_URL. Run `npm run test:ensure-db` once to create/initialise the test database.
PORT=3001
NODE_ENV=development

# Phase 1 placeholders (not used in Phase 0)
# JWT_SECRET=
# SESSION_SECRET=
